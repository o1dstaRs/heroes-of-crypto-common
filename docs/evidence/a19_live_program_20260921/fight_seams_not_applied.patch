@@ -0,0 +1,150 @@
+import { describe, expect, it } from "bun:test";
+import type { IDecisionContext } from "../../src/ai";
+import { enumerateCandidates, type IEnumeratedCandidate } from "../../src/ai/candidates";
+import type { GameAction } from "../../src/engine/actions";
+import { PBTypes } from "../../src/generated/protobuf/v1/types";
+import { PathHelper } from "../../src/grid/path_helper";
+import { reserveEdgeOfReachShortlist } from "../../src/simulation/search_driver";
+import type { Unit } from "../../src/units/unit";
+import type { XY } from "../../src/utils/math";
+import { createCombatTestContext, createTestUnit, placeUnit, testGridSettings, type CombatTestContext } from "../helpers/combat";
+
+const LEFT = PBTypes.TeamVals.LEFT;
+const RIGHT = PBTypes.TeamVals.RIGHT;
+const MELEE = PBTypes.AttackVals.MELEE;
+const RANGE = PBTypes.AttackVals.RANGE;
+
+function ctxFor(c: CombatTestContext): IDecisionContext {
+    return {
+        grid: c.grid,
+        matrix: c.grid.getMatrix(),
+        unitsHolder: c.unitsHolder,
+        pathHelper: new PathHelper(testGridSettings),
+        attackHandler: c.attackHandler,
+        fightProperties: undefined,
+    };
+}
+const endTurn = (unit: Unit): GameAction[] => [{ type: "end_turn", unitId: unit.getId() }];
+const moves = (candidates: readonly IEnumeratedCandidate[]): IEnumeratedCandidate[] =>
+    candidates.filter((candidate) => candidate.kind === "move");
+const manhattan = (a: XY, b: XY): number => Math.abs(a.x - b.x) + Math.abs(a.y - b.y);
+/** Cells the enemy can strike next turn on this board: every reachable anchor plus its own, widened by one. */
+function enemyStrikeCells(c: CombatTestContext, enemy: Unit, ourTeam: number): Set<string> {
+    const anchors = [
+        enemy.getBaseCell(),
+        ...new PathHelper(testGridSettings).getMovePath(
+            enemy.getBaseCell(),
+            c.grid.getMatrix(),
+            enemy.getSteps(),
+            c.grid.getAggrMatrixByTeam(ourTeam),
+            enemy.canFly(),
+            enemy.isSmallSize(),
+            enemy.canTraverseLava(),
+            false,
+            enemy.getFootprintWidth(),
+            enemy.getFootprintHeight(),
+        ).cells,
+    ];
+    const out = new Set<string>();
+    for (const anchor of anchors) {
+        for (let dy = -1; dy <= 1; dy += 1) for (let dx = -1; dx <= 1; dx += 1) out.add(`${anchor.x + dx},${anchor.y + dy}`);
+    }
+    return out;
+}
+
+describe("candidates — opt-in edge-of-reach advance (SEARCH_A19_EDGE_OF_REACH_MOVE)", () => {
+    it("is an exact identity when the option is off or false", () => {
+        const c = createCombatTestContext();
+        const unit = createTestUnit({ team: LEFT, name: "Line", attackType: MELEE, initiative: 4 });
+        const enemy = createTestUnit({ team: RIGHT, name: "E", attackType: MELEE, initiative: 3 });
+        placeUnit(c.grid, c.unitsHolder, unit, { x: 8, y: 3 });
+        placeUnit(c.grid, c.unitsHolder, enemy, { x: 8, y: 13 });
+        const off = enumerateCandidates(unit, ctxFor(c), endTurn(unit), { maxMoveDestinations: 1 });
+        const explicitOff = enumerateCandidates(unit, ctxFor(c), endTurn(unit), {
+            maxMoveDestinations: 1,
+            retainEdgeOfReachMove: false,
+        });
+        expect(explicitOff.candidates.map((x) => x.actions)).toEqual(off.candidates.map((x) => x.actions));
+        expect(off.candidates.some((x) => x.edgeOfReachReserved)).toBe(false);
+        expect(moves(off.candidates)).toHaveLength(1);
+    });
+
+    it("retains one marked ADVANCING destination outside every enemy melee stack's reach beside the nearest move", () => {
+        const c = createCombatTestContext();
+        // Test units walk 3 steps. From y=6 the nearest advance (8,9) is one cell short of an enemy that can step to
+        // (8,10) and strike; (8,8) still advances and stays out of that reach.
+        const unit = createTestUnit({ team: LEFT, name: "Line", attackType: MELEE, initiative: 4 });
+        const enemy = createTestUnit({ team: RIGHT, name: "E", attackType: MELEE, initiative: 3 });
+        placeUnit(c.grid, c.unitsHolder, unit, { x: 8, y: 6 });
+        placeUnit(c.grid, c.unitsHolder, enemy, { x: 8, y: 13 });
+        const currentDistance = manhattan(unit.getBaseCell(), enemy.getBaseCell());
+        const withEdge = enumerateCandidates(unit, ctxFor(c), endTurn(unit), {
+            maxMoveDestinations: 1,
+            retainEdgeOfReachMove: true,
+        });
+        const kept = moves(withEdge.candidates);
+        expect(kept).toHaveLength(2);
+        const nearest = kept[0];
+        const edge = kept[1];
+        expect(nearest.edgeOfReachReserved).toBeUndefined();
+        expect(edge.edgeOfReachReserved).toBe(true);
+        // Both advance; the nearest move is strictly nearer than the edge move.
+        expect(manhattan(nearest.targetCell!, enemy.getBaseCell())).toBeLessThan(currentDistance);
+        expect(manhattan(edge.targetCell!, enemy.getBaseCell())).toBeLessThan(currentDistance);
+        expect(manhattan(nearest.targetCell!, enemy.getBaseCell())).toBeLessThan(manhattan(edge.targetCell!, enemy.getBaseCell()));
+        // The edge cell is outside the enemy's strike set; the nearest one is inside it.
+        const strike = enemyStrikeCells(c, enemy, LEFT);
+        expect(strike.has(`${edge.targetCell!.x},${edge.targetCell!.y}`)).toBe(false);
+        expect(strike.has(`${nearest.targetCell!.x},${nearest.targetCell!.y}`)).toBe(true);
+        // And it is the NEAREST such cell: no unmarked reachable destination outside reach is closer.
+        const all = moves(enumerateCandidates(unit, ctxFor(c), endTurn(unit)).candidates);
+        const safeCloser = all.filter(
+            (m) =>
+                !strike.has(`${m.targetCell!.x},${m.targetCell!.y}`) &&
+                manhattan(m.targetCell!, enemy.getBaseCell()) < manhattan(edge.targetCell!, enemy.getBaseCell()),
+        );
+        expect(safeCloser).toHaveLength(0);
+    });
+
+    it("adds nothing when every advance is inside reach, for a shooter with ammunition, or with no enemies", () => {
+        const c = createCombatTestContext();
+        const unit = createTestUnit({ team: LEFT, name: "Line", attackType: MELEE, initiative: 2 });
+        const fast = createTestUnit({ team: RIGHT, name: "Fast", attackType: MELEE, initiative: 12 });
+        placeUnit(c.grid, c.unitsHolder, unit, { x: 8, y: 6 });
+        placeUnit(c.grid, c.unitsHolder, fast, { x: 8, y: 9 });
+        const covered = enumerateCandidates(unit, ctxFor(c), endTurn(unit), { maxMoveDestinations: 1, retainEdgeOfReachMove: true });
+        expect(moves(covered.candidates)).toHaveLength(1);
+        expect(covered.candidates.some((x) => x.edgeOfReachReserved)).toBe(false);
+
+        const c2 = createCombatTestContext();
+        const shooter = createTestUnit({ team: LEFT, name: "Bow", attackType: RANGE, rangeShots: 5, initiative: 4 });
+        const enemy = createTestUnit({ team: RIGHT, name: "E", attackType: MELEE, initiative: 3 });
+        placeUnit(c2.grid, c2.unitsHolder, shooter, { x: 8, y: 3 });
+        placeUnit(c2.grid, c2.unitsHolder, enemy, { x: 8, y: 13 });
+        const shooterSet = enumerateCandidates(shooter, ctxFor(c2), endTurn(shooter), { maxMoveDestinations: 1, retainEdgeOfReachMove: true });
+        expect(shooterSet.candidates.some((x) => x.edgeOfReachReserved)).toBe(false);
+
+        const c3 = createCombatTestContext();
+        const alone = createTestUnit({ team: LEFT, name: "Alone", attackType: MELEE, initiative: 4 });
+        placeUnit(c3.grid, c3.unitsHolder, alone, { x: 8, y: 3 });
+        const aloneSet = enumerateCandidates(alone, ctxFor(c3), endTurn(alone), { maxMoveDestinations: 1, retainEdgeOfReachMove: true });
+        expect(aloneSet.candidates.some((x) => x.edgeOfReachReserved)).toBe(false);
+    });
+
+    it("the shortlist reservation appends the marked candidate only when the leaf pre-pass dropped it", () => {
+        const mk = (kind: IEnumeratedCandidate["kind"], reserved = false): IEnumeratedCandidate => ({
+            kind,
+            actions: [],
+            features: {} as IEnumeratedCandidate["features"],
